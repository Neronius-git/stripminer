{
	"schemaVersion": 1,
	"id": "stripminer",
	"version": "${version}",
	"name": "Strip Miner",
	"description": "Strip-mines on its own: digs down to diamond level, mines every ore cluster it finds (including hidden parts), picks up the drops and avoids lava. Also chops down big 2x2 trees and whole groups of them. Commands: /stripmine help",
	"authors": ["Neronius-git"],
	"contact": {
		"homepage": "https://github.com/Neronius-git/stripminer",
		"sources": "https://github.com/Neronius-git/stripminer",
		"issues": "https://github.com/Neronius-git/stripminer/issues"
	},
	"license": "MIT",
	"icon": "assets/stripminer/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.stripminer.StripMinerClient"]
	},
	"mixins": ["stripminer.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
